# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Native C++ build directories (build-portable-cpp.sh's own build tree;
# build/ above already covers the plain CMake dev build)
build-portable-cpp/

# Virtual environments
.venv

# PyInstaller (built via build.sh, which passes flags on the CLI - the
# auto-generated .spec file is just a byproduct, not used to rebuild)
*.spec
